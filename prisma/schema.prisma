generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Party {
  id                 String   @id @default(cuid())
  // S2: ط§ظ„ط¨ظ†ظˆط¯ ط§ظ„ط¥ط¶ط§ظپظٹط© ط§ظ„ظ…ط³ط¬ظ„ط© ط¹ظ„ظ‰ ط§ظ„ط·ط±ظپ ظƒظ…ظ‚ط§ظˆظ„ (طھط¹طھظٹظ‚/ظ…ط¨ظٹطھ/ظ…ط±طھط¬ط¹ط§طھ)
  code               String?
  name               String
  nameEn             String?
  isCustomer         Boolean  @default(false)
  isContractor       Boolean  @default(false)
  isSupplier         Boolean  @default(false)
  phone              String?
  phones             String?
  email              String?
  address            String?
  city               String?
  region             String?
  taxNumber          String?
  paymentTerms       String?
  creditLimit        Float?
  openingBalance     Float    @default(0)
  openingBalanceType String?
  branchId           String?
  notes              String?
  documents          String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branch             Branch?  @relation(fields: [branchId], references: [id])
  shipmentsAsCustomer   Shipment[]     @relation("CustomerShipments")
  shipmentsAsContractor Shipment[]     @relation("ContractorShipments")
  journalLines          JournalLine[]
  courierVouchers       OpVoucher[]    @relation("OpVoucherCourier")
  partyVouchers         OpVoucher[]    @relation("OpVoucherParty")
  extraCosts            ExtraCost[]    @relation("ExtraCostContractor")
  invoices              Invoice[]      @relation("InvoiceCustomer")
}

model Branch {
  id        String   @id @default(cuid())
  code      String?
  name      String
  nameEn    String?
  manager   String?
  phone     String?
  address   String?
  region    String?
  balance   Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  warehouses       Warehouse[]
  shipments        Shipment[]
  parties          Party[]
  journalEntries   JournalEntry[]
  costCenters      CostCenter[]
  users            User[]
  opVouchersSource OpVoucher[] @relation("OpVoucherSource")
  opVouchersDest   OpVoucher[] @relation("OpVoucherDest")
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String?
  name      String
  branchId  String
  manager   String?
  balance   Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  branch    Branch     @relation(fields: [branchId], references: [id])
  items     Item[]
  movements InventoryMovement[]
  shipments Shipment[]
}

model Item {
  id           String   @id @default(cuid())
  code         String?
  name         String
  nameEn       String?
  unit         String?
  reorderLevel Float?
  cost         Float    @default(0)
  price        Float    @default(0)
  warehouseId  String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  warehouse Warehouse?           @relation(fields: [warehouseId], references: [id])
  movements InventoryMovement[]
}

model InventoryMovement {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  type          String
  itemId        String
  warehouseId   String
  toWarehouseId String?
  quantity      Float
  unitCost      Float?
  totalCost     Float?
  reference     String?
  notes         String?
  status        String   @default("approved")
  userId        String?
  userName      String?
  createdAt     DateTime @default(now())
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

model Shipment {
  id            String    @id @default(cuid())
  shipmentNo    String?
  billNo        String?
  // ط§ظ„ظپظˆط§طھظٹط±: ط§ظ„ط´ط­ظ†ط© ط§ظ„ظ…ظپظˆطھط±ط© ط¨ظپط§طھظˆط±ط© ظ†ط´ط·ط© (ظٹظڈظپظƒ ط§ظ„ط±ط¨ط· ط¹ظ†ط¯ ط¥ظ„ط؛ط§ط، ط§ظ„ظپط§طھظˆط±ط©)
  // ط§ظ„ط­ظ‚ظ„ ظˆط­ط¯ظ‡ ظٹظ…ظ†ط¹ ط§ظ„ظپظˆطھط±ط© ط§ظ„ظ…ط²ط¯ظˆط¬ط© (ظ‚ظٹظ…ط© ظˆط§ط­ط¯ط© ظ„ظƒظ„ ط´ط­ظ†ط©) + طھط­ظ‚ظ‚ طھط·ط¨ظٹظ‚ظٹ ط¹ظ„ظ‰ ط§ظ„ط®ط§ط¯ظ…
  invoiceId     String?
  policyQty     Float?
  customerId    String?
  customer      Party?    @relation("CustomerShipments", fields: [customerId], references: [id])
  recipientName String?
  shipToParty   String?
  deliveryPhones String?
  pickupAddress String?
  deliveryAddress String?
  destination   String?
  destinationEn String?
  routeCode     String?
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  loadType      String?
  // ط´ظٹطھ ط§ظ„طھظˆط²ظٹط¹ ط§ظ„ظٹظˆظ…ظٹ ظ…ظ† ط§ظ„ط¹ظ…ظٹظ„: Ship Part = ط±ظ‚ظ… ط£ظ…ط± ط§ظ„ط´ط­ظ† ط§ظ„ظ…ط±ط¬ط¹ظٹ ط¹ظ†ط¯ ط§ظ„ط¹ظ…ظٹظ„
  shipPart      String?
  // ط¹ط¯ط¯ ط§ظ„ط´ط§ط­ظ†ط§طھ ظƒظ…ط§ ظٹط£طھظٹ ظپظٹ ط¹ظ…ظˆط¯ Truck ط¨ط§ظ„ط´ظٹطھ (ظ…ط³طھظ‚ظ„ ط¹ظ† ط§ظ„ظ…ظ‚ط§ط³ط§طھ ton15/ton3/m6)
  truckCount    Float?
  ton15         Float?
  ton3          Float?
  m6            Float?
  drop          Float?
  worker        String?
  contractorId  String?
  contractor    Party?   @relation("ContractorShipments", fields: [contractorId], references: [id])
  vehicleNo     String?
  freightCost   Float?
  freightTotal  Float?
  salePrice     Float?
  customerPay   Float?
  aging         Float?
  overnight     Float?
  returns       Float?
  transfer      Float?
  other         Float?
  totalSuppliers Float?
  status        String   @default("new")
  collectionStatus String @default("uncollected")
  // S2: ط£ط°ظˆظ†ط§طھ ط§ظ„طھط³ظ„ظٹظ… â€” ط±ظ‚ظ… ط§ظ„ط¯ظٹظ„ظٹظپط±ظٹ ظ‡ظˆ ط§ظ„ظ…ط¹ط±ظپ ط§ظ„ط¨ط­ط«ظٹ ط§ظ„ط£ط³ط§ط³ظٹ ظ„ظ„ظ…ظ‚ط§ظˆظ„
  deliveryNumber      String?   @unique  // ظپط±ظٹط¯ ط¹ظ„ظ‰ ظ…ط³طھظˆظ‰ ط§ظ„ظ†ط¸ط§ظ… â€” ظ…ظ†ط¹ طھط³ط¬ظٹظ„ ظ†ظپط³ ط±ظ‚ظ… ط§ظ„ط¯ظٹظ„ظٹظپط±ظٹ ظ„ط´ط­طھظٹظ†
  isReceiptDelivered  Boolean   @default(false)
  receiptDeliveredAt  DateTime?
  date          DateTime?
  shippingDate  DateTime?
  expectedDeliveryDate DateTime?
  actualDeliveryDate DateTime?
  date2         DateTime?
  notes         String?
  note1         String?
  attachments   String?
  sFlag         String?
  warehouseOrig String?
  m1            String?
  m2            String?
  xCol          String?
  card          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  statusHistory ShipmentStatusHistory[]
  journalLines  JournalLine[]
  opVoucherItems OpVoucherItem[]
  extraCosts    ExtraCost[]
  invoice       Invoice?  @relation("ShipmentInvoice", fields: [invoiceId], references: [id])
  invoiceItems  InvoiceItem[]

  @@index([contractorId, isReceiptDelivered])
  @@index([invoiceId])
}

// ============================================================
// ط§ظ„ظپظˆط§طھظٹط± ط§ظ„ط±ط³ظ…ظٹط© ظ„ظ„ط¹ظ…ظ„ط§ط، (S3) â€” ظپط§طھظˆط±ط© ط¶ط±ظٹط¨ظٹط© ط¹ظ„ظ‰ ظ†ظˆظ„ظˆظ† ط§ظ„ط´ط­ظ†ط§طھ
// ط¯ظˆط±ط© ط§ظ„ط­ظٹط§ط©: draft (ظ…ط³ظˆط¯ط© â€” ظ„ط§ ظ‚ظٹط¯) â†گ issued (طµط§ط¯ط±ط© â€” ظ‚ظٹط¯ ظ…ط²ط¯ظˆط¬:
//   ظ…ط¯ظٹظ† ط§ظ„ط¹ظ…ظ„ط§ط، 1103 ط¨ط§ظ„ط¥ط¬ظ…ط§ظ„ظٹ ط´ط§ظ…ظ„ ط§ظ„ط¶ط±ظٹط¨ط© / ط¯ط§ط¦ظ† ط¥ظٹط±ط§ط¯ ط§ظ„ط´ط­ظ† 4101
