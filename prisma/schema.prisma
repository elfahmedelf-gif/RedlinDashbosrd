model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique          // INV-0001 (طھط³ظ„ط³ظ„ظٹ ط¢ظ…ظ†)
  customerId     String
  issueDate      DateTime  @default(now())
  dueDate        DateTime?
  status         String    @default("draft") // draft|issued|partially_paid|paid|cancelled
  subtotal       Float     @default(0)      // ط¥ط¬ظ…ط§ظ„ظٹ ط§ظ„ط¨ظ†ظˆط¯ ظ‚ط¨ظ„ ط§ظ„ط®طµظ… ظˆط§ظ„ط¶ط±ظٹط¨ط©
  vatRate        Float     @default(14)     // ظ†ط³ط¨ط© ط¶ط±ظٹط¨ط© ط§ظ„ظ‚ظٹظ…ط© ط§ظ„ظ…ط¶ط§ظپط© (14 ط£ظˆ 0)
  vatAmount      Float     @default(0)      // ظ‚ظٹظ…ط© ط§ظ„ط¶ط±ظٹط¨ط© ط§ظ„ظ…ط­ط³ظˆط¨ط©
  discountAmount Float     @default(0)      // ط§ظ„ط®طµظ… ط§ظ„ظ…ظ…ظ†ظˆط­
  totalAmount    Float     @default(0)      // ط§ظ„ط¥ط¬ظ…ط§ظ„ظٹ ط§ظ„ظ†ظ‡ط§ط¦ظٹ ط´ط§ظ…ظ„ ط§ظ„ط¶ط±ظٹط¨ط©
  paidAmount     Float     @default(0)      // ط§ظ„ظ…ط³ط¯ط¯ ظ…ظ† ط³ظ†ط¯ط§طھ ط§ظ„ظ‚ط¨ط¶ ط§ظ„ظ…ط±طھط¨ط·ط©
  notes          String?
  journalEntryId String?   @unique          // ظ‚ظٹط¯ ط§ظ„ط¥طµط¯ط§ط± (ظٹظڈظ†ط´ط£ ظ…ط±ط© ظˆط§ط­ط¯ط© ط¹ظ†ط¯ ط§ظ„ط¥طµط¯ط§ط±)
  createdById    String?
  createdByName  String?
  issuedById     String?
  issuedByName   String?
  issuedAt       DateTime?
  cancelledById  String?
  cancelledByName String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer    Party         @relation("InvoiceCustomer", fields: [customerId], references: [id])
  journalEntry JournalEntry? @relation("InvoiceJournal", fields: [journalEntryId], references: [id])
  items       InvoiceItem[]
  payments    OpVoucher[]   @relation("OpVoucherInvoice")
  shipments   Shipment[]    @relation("ShipmentInvoice")

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  shipmentId  String?             // ط¨ظ†ط¯ ظ…ط±طھط¨ط· ط¨ط´ط­ظ†ط© (ط§ط®طھظٹط§ط±ظٹ â€” ظٹظ…ظ†ط¹ ط§ظ„ظپظˆطھط±ط© ط§ظ„ظ…ط²ط¯ظˆط¬ط© ط¨ط§ظ„طھط­ظ‚ظ‚ ط¹ظ„ظ‰ ط§ظ„ط®ط§ط¯ظ…)
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  total       Float   @default(0)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@index([invoiceId])
  @@index([shipmentId])
}

model ShipmentStatusHistory {
  id         String   @id @default(cuid())
  shipmentId String
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now())
  userId     String?
  userName   String?
  notes      String?
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model FreightPrice {
  id         String    @id @default(cuid())
  regionAr   String?
  regionEn   String?
  routeName  String?
  distanceKm String?
  loadType   String?
  cost       Float?
  sellPrice  Float?
  sellPrice2 Float?
  validFrom  DateTime?
  validTo    DateTime?
  notes      String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Account {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameEn    String?
  type      String
  parentId  String?
  isDetail  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]
  cashVouchers OpVoucher[] @relation("OpVoucherCashAccount")
}

model CostCenter {
  id       String   @id @default(cuid())
  code     String?
  name     String
  branchId String?
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
  branch Branch? @relation(fields: [branchId], references: [id])
}

model JournalEntry {
  id          String    @id @default(cuid())
  entryNo     String    @unique
  date        DateTime  @default(now())
  branchId    String?
  description String?
  reference   String?
  sourceType  String?
  sourceId    String?
  status      String   @default("draft") // draft | posted | void
  totalDebit  Float    @default(0)
  totalCredit Float    @default(0)
  userId      String?
  userName    String?
  postedByUserId String?
  postedByUserName String?
  postedAt    DateTime?
  reversalOfId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch     Branch?          @relation(fields: [branchId], references: [id])
  lines      JournalLine[]
  reversalOf JournalEntry?    @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals  JournalEntry[]   @relation("JournalReversal")
  opVouchers OpVoucher[]
  extraCosts ExtraCost[]      @relation("ExtraCostJournal")
  invoice    Invoice?         @relation("InvoiceJournal")
}

model JournalLine {
  id          String  @id @default(cuid())
  entryId     String
  accountId   String
  debit       Float   @default(0)
  credit      Float   @default(0)
  description String?
  partyId     String?
  shipmentId  String?
  costCenterId String?
  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account  Account      @relation(fields: [accountId], references: [id])
  party    Party?       @relation(fields: [partyId], references: [id])
  shipment Shipment?    @relation(fields: [shipmentId], references: [id])

  @@index([accountId])
  @@index([entryId])
}

// ============================================================
// ط§ظ„ط£ط°ظˆظ†ط§طھ ط§ظ„طھط´ط؛ظٹظ„ظٹط© ط§ظ„ظ…ظˆط­ط¯ط© (16 ظ†ظˆط¹ظ‹ط§: طھط´ط؛ظٹظ„ظٹط©/ظ…ط§ظ„ظٹط©/ط¬ط±ط¯/ط®ط§طµط©)
// ============================================================
model OpVoucher {
  id             String    @id @default(cuid())
  voucherNo      String    @unique
  type           String
  status         String    @default("draft") // draft|pending|approved|in_progress|completed|rejected|cancelled
  sourceBranchId String?
  destBranchId   String?
  employeeId     String? // ظ…ظˆط¸ظپ ظ…ط³ط¤ظˆظ„ (User)
  courierId      String? // ظ…ظ†ط¯ظˆط¨ (Party)
  partyId        String? // ط·ط±ظپ ظ…ط§ظ„ظٹ (ط¹ظ…ظٹظ„/ظ…ظ‚ط§ظˆظ„)
  amount         Float?
  totalValue     Float     @default(0)
  notes          String?
  accountName    String?
  cashAccountId  String? // ط®ط²ظٹظ†ط©/ط¨ظ†ظƒ ظ…ط±طھط¨ط· (Account)
  vehicleNo      String?
  driverName     String?
  journalEntryId String?   @unique // ط§ظ„ظ‚ظٹط¯ ط§ظ„ظ…ط­ط§ط³ط¨ظٹ ط§ظ„ظ…ط±طھط¨ط· (ظ„ظ„ط³ظ†ط¯ط§طھ ط§ظ„ظ…ط§ظ„ظٹط©)
  userId         String? // ط§ظ„ظ…ظ†ط´ط¦ (User)
  userName       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sourceBranch  Branch?       @relation("OpVoucherSource", fields: [sourceBranchId], references: [id])
  destBranch    Branch?       @relation("OpVoucherDest", fields: [destBranchId], references: [id])
  employee      User?         @relation("OpVoucherEmployee", fields: [employeeId], references: [id])
  creator       User?         @relation("OpVoucherCreator", fields: [userId], references: [id])
  courier       Party?        @relation("OpVoucherCourier", fields: [courierId], references: [id])
  party         Party?        @relation("OpVoucherParty", fields: [partyId], references: [id])
  cashAccount   Account?      @relation("OpVoucherCashAccount", fields: [cashAccountId], references: [id])
  journalEntry  JournalEntry? @relation(fields: [journalEntryId], references: [id])
  invoiceId     String?              // ط³ظ†ط¯ ظ‚ط¨ط¶ ظ…ط±طھط¨ط· ط¨ظپط§طھظˆط±ط© ط¹ظ…ظٹظ„ (ط¯ظپط¹ط© طھط­طµظٹظ„)
  invoice       Invoice?      @relation("OpVoucherInvoice", fields: [invoiceId], references: [id])
  items         OpVoucherItem[]
  actions       OpVoucherAction[]

  @@index([invoiceId])

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model OpVoucherItem {
  id         String   @id @default(cuid())
  voucherId  String
  shipmentId String
  notes      String?
  addedAt    DateTime @default(now())
  addedBy    String?
  voucher  OpVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  shipment Shipment  @relation(fields: [shipmentId], references: [id])

  @@unique([voucherId, shipmentId])
  @@index([shipmentId])
}

model OpVoucherAction {
  id        String   @id @default(cuid())
  voucherId String
  action    String
  userId    String?
  userName  String
  at        DateTime @default(now())
  notes     String?
  voucher OpVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

