// Prisma schema - Shipping Company Management System
// S1 (2026): إضافة منظومة الأذونات التشغيلية الموحدة + محرك محاسبي كامل
//   - OpVoucher / OpVoucherItem / OpVoucherAction (16 نوعًا × 7 حالات)
//   - JournalEntry.reversalOfId (قيد عكسي) + postedBy
//   - SeqCounter (أرقام تسلسلية آمنة) + IdempotencyKey (منع تكرار العمليات)
//   - حذف نموذج Voucher القديم (كان ماليًا فقط ولا يُستخدم — مساراته أوفية فارغة)
// S2 (2026): منظومة أذونات التسليم للعملاء (إذن التسليم لكل نقلة) + البنود الإضافية
//   - Shipment.deliveryNumber (رقم الديليفري) + isReceiptDelivered/receiptDeliveredAt
//   - ExtraCost (تعتيق/مبيت/مرتجعات) مع دورة اعتماد PENDING→APPROVED/REJECTED
//     والربط المحاسبي: قيد مزدوج (مدين مصروف/دائن مستحقات المقاول 2102) عند الاعتماد
//     بحيث تُحسب في مستحقات المقاول فقط بعد موافقة الشركة — دون تكرار للبيانات

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Party {
  id                 String   @id @default(cuid())
  // S2: البنود الإضافية المسجلة على الطرف كمقاول (تعتيق/مبيت/مرتجعات)
  code               String?
  name               String
  nameEn             String?
  isCustomer         Boolean  @default(false)
  isContractor       Boolean  @default(false)
  isSupplier         Boolean  @default(false)
  phone              String?
  phones             String?
  email              String?
  address            String?
  city               String?
  region             String?
  taxNumber          String?
  paymentTerms       String?
  creditLimit        Float?
  openingBalance     Float    @default(0)
  openingBalanceType String?
  branchId           String?
  notes              String?
  documents          String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branch             Branch?  @relation(fields: [branchId], references: [id])
  shipmentsAsCustomer   Shipment[]     @relation("CustomerShipments")
  shipmentsAsContractor Shipment[]     @relation("ContractorShipments")
  journalLines          JournalLine[]
  courierVouchers       OpVoucher[]    @relation("OpVoucherCourier")
  partyVouchers         OpVoucher[]    @relation("OpVoucherParty")
  extraCosts            ExtraCost[]    @relation("ExtraCostContractor")
  invoices              Invoice[]      @relation("InvoiceCustomer")
}

model Branch {
  id        String   @id @default(cuid())
  code      String?
  name      String
  nameEn    String?
  manager   String?
  phone     String?
  address   String?
  region    String?
  balance   Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  warehouses       Warehouse[]
  shipments        Shipment[]
  parties          Party[]
  journalEntries   JournalEntry[]
  costCenters      CostCenter[]
  users            User[]
  opVouchersSource OpVoucher[] @relation("OpVoucherSource")
  opVouchersDest   OpVoucher[] @relation("OpVoucherDest")
  operatingExpenses OperatingExpense[]
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String?
  name      String
  branchId  String
  manager   String?
  balance   Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  branch    Branch     @relation(fields: [branchId], references: [id])
  items     Item[]
  movements InventoryMovement[]
  shipments Shipment[]
}

model Item {
  id           String   @id @default(cuid())
  code         String?
  name         String
  nameEn       String?
  unit         String?
  reorderLevel Float?
  cost         Float    @default(0)
  price        Float    @default(0)
  warehouseId  String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  warehouse Warehouse?           @relation(fields: [warehouseId], references: [id])
  movements InventoryMovement[]
}

model InventoryMovement {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  type          String
  itemId        String
  warehouseId   String
  toWarehouseId String?
  quantity      Float
  unitCost      Float?
  totalCost     Float?
  reference     String?
  notes         String?
  status        String   @default("approved")
  userId        String?
  userName      String?
  createdAt     DateTime @default(now())
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

model Shipment {
  id            String    @id @default(cuid())
  shipmentNo    String?
  billNo        String?
  // الفواتير: الشحنة المفوترة بفاتورة نشطة (يُفك الربط عند إلغاء الفاتورة)
  // الحقل وحده يمنع الفوترة المزدوجة (قيمة واحدة لكل شحنة) + تحقق تطبيقي على الخادم
  invoiceId     String?
  policyQty     Float?
  customerId    String?
  customer      Party?    @relation("CustomerShipments", fields: [customerId], references: [id])
  recipientName String?
  shipToParty   String?
  deliveryPhones String?
  pickupAddress String?
  deliveryAddress String?
  destination   String?
  destinationEn String?
  routeCode     String?
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  loadType      String?
  // شيت التوزيع اليومي من العميل: Ship Part = رقم أمر الشحن المرجعي عند العميل
  shipPart      String?
  // عدد الشاحنات كما يأتي في عمود Truck بالشيت (مستقل عن المقاسات ton15/ton3/m6)
  truckCount    Float?
  ton15         Float?
  ton3          Float?
  m6            Float?
  drop          Float?
  worker        String?
  contractorId  String?
  contractor    Party?   @relation("ContractorShipments", fields: [contractorId], references: [id])
  vehicleNo     String?
  freightCost   Float?
  freightTotal  Float?
  salePrice     Float?
  customerPay   Float?
  aging         Float?
  overnight     Float?
  returns       Float?
  transfer      Float?
  other         Float?
  totalSuppliers Float?
  status        String   @default("new")
  collectionStatus String @default("uncollected")
  // S2: أذونات التسليم — رقم الديليفري هو المعرف البحثي الأساسي للمقاول
  deliveryNumber      String?   @unique  // فريد على مستوى النظام — منع تسجيل نفس رقم الديليفري لشحتين
  isReceiptDelivered  Boolean   @default(false)
  receiptDeliveredAt  DateTime?
  date          DateTime?
  shippingDate  DateTime?
  expectedDeliveryDate DateTime?
  actualDeliveryDate DateTime?
  date2         DateTime?
  notes         String?
  note1         String?
  attachments   String?
  sFlag         String?
  warehouseOrig String?
  m1            String?
  m2            String?
  xCol          String?
  card          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  statusHistory ShipmentStatusHistory[]
  journalLines  JournalLine[]
  opVoucherItems OpVoucherItem[]
  extraCosts    ExtraCost[]
  invoice       Invoice?  @relation("ShipmentInvoice", fields: [invoiceId], references: [id])
  invoiceItems  InvoiceItem[]

  @@index([contractorId, isReceiptDelivered])
  @@index([invoiceId])
}

// ============================================================
// الفواتير الرسمية للعملاء (S3) — فاتورة ضريبية على نولون الشحنات
// دورة الحياة: draft (مسودة — لا قيد) ← issued (صادرة — قيد مزدوج:
//   مدين العملاء 1103 بالإجمالي شامل الضريبة / دائن إيراد الشحن 4101
//   بصافي القيمة / دائن ضريبة القيمة المضافة 2103 بقيمة الضريبة)
//   ← partially_paid/paid (سندات قبض مرتبطة) — والإلغاء يُرحّل قيدًا عكسيًا
//   ويفك ربط الشحنات لتُفوتر من جديد (الإيراد لا يُحتسب مرتين أبدًا:
//   عند الإصدار يُعكس قيد استحقاق التسليم للشحنات المُدخلة ويُعاد
//   إثبات مستحقات المقاول فقط بحساب مستقل)
// ============================================================
model Invoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique          // INV-0001 (تسلسلي آمن)
  customerId     String
  issueDate      DateTime  @default(now())
  dueDate        DateTime?
  status         String    @default("draft") // draft|issued|partially_paid|paid|cancelled
  subtotal       Float     @default(0)      // إجمالي البنود قبل الخصم والضريبة
  vatRate        Float     @default(14)     // نسبة ضريبة القيمة المضافة (14 أو 0)
  vatAmount      Float     @default(0)      // قيمة الضريبة المحسوبة
  discountAmount Float     @default(0)      // الخصم الممنوح
  totalAmount    Float     @default(0)      // الإجمالي النهائي شامل الضريبة
  paidAmount     Float     @default(0)      // المسدد من سندات القبض المرتبطة
  notes          String?
  journalEntryId String?   @unique          // قيد الإصدار (يُنشأ مرة واحدة عند الإصدار)
  createdById    String?
  createdByName  String?
  issuedById     String?
  issuedByName   String?
  issuedAt       DateTime?
  cancelledById  String?
  cancelledByName String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer    Party         @relation("InvoiceCustomer", fields: [customerId], references: [id])
  journalEntry JournalEntry? @relation("InvoiceJournal", fields: [journalEntryId], references: [id])
  items       InvoiceItem[]
  payments    OpVoucher[]   @relation("OpVoucherInvoice")
  shipments   Shipment[]    @relation("ShipmentInvoice")

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  shipmentId  String?             // بند مرتبط بشحنة (اختياري — يمنع الفوترة المزدوجة بالتحقق على الخادم)
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  total       Float   @default(0)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@index([invoiceId])
  @@index([shipmentId])
}

model ShipmentStatusHistory {
  id         String   @id @default(cuid())
  shipmentId String
  fromStatus String?
  toStatus   String
  changedAt  DateTime @default(now())
  userId     String?
  userName   String?
  notes      String?
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model FreightPrice {
  id         String    @id @default(cuid())
  regionAr   String?
  regionEn   String?
  routeName  String?
  distanceKm String?
  loadType   String?
  cost       Float?
  sellPrice  Float?
  sellPrice2 Float?
  validFrom  DateTime?
  validTo    DateTime?
  notes      String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Account {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameEn    String?
  type      String
  parentId  String?
  isDetail  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]
  cashVouchers OpVoucher[] @relation("OpVoucherCashAccount")
  operatingExpensesExpense OperatingExpense[] @relation("OpExExpenseAccount")
  operatingExpensesPay    OperatingExpense[] @relation("OpExPayAccount")
}

model CostCenter {
  id       String   @id @default(cuid())
  code     String?
  name     String
  branchId String?
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
  branch Branch? @relation(fields: [branchId], references: [id])
}

model JournalEntry {
  id          String    @id @default(cuid())
  entryNo     String    @unique
  date        DateTime  @default(now())
  branchId    String?
  description String?
  reference   String?
  sourceType  String?
  sourceId    String?
  status      String   @default("draft") // draft | posted | void
  totalDebit  Float    @default(0)
  totalCredit Float    @default(0)
  userId      String?
  userName    String?
  postedByUserId String?
  postedByUserName String?
  postedAt    DateTime?
  reversalOfId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch     Branch?          @relation(fields: [branchId], references: [id])
  lines      JournalLine[]
  reversalOf JournalEntry?    @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals  JournalEntry[]   @relation("JournalReversal")
  opVouchers OpVoucher[]
  extraCosts ExtraCost[]      @relation("ExtraCostJournal")
  invoice    Invoice?         @relation("InvoiceJournal")
  operatingExpenses OperatingExpense[] @relation("OpExJournal")
}

model JournalLine {
  id          String  @id @default(cuid())
  entryId     String
  accountId   String
  debit       Float   @default(0)
  credit      Float   @default(0)
  description String?
  partyId     String?
  shipmentId  String?
  costCenterId String?
  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account  Account      @relation(fields: [accountId], references: [id])
  party    Party?       @relation(fields: [partyId], references: [id])
  shipment Shipment?    @relation(fields: [shipmentId], references: [id])

  @@index([accountId])
  @@index([entryId])
}

// ============================================================
// الأذونات التشغيلية الموحدة (16 نوعًا: تشغيلية/مالية/جرد/خاصة)
// ============================================================
model OpVoucher {
  id             String    @id @default(cuid())
  voucherNo      String    @unique
  type           String
  status         String    @default("draft") // draft|pending|approved|in_progress|completed|rejected|cancelled
  sourceBranchId String?
  destBranchId   String?
  employeeId     String? // موظف مسؤول (User)
  courierId      String? // مندوب (Party)
  partyId        String? // طرف مالي (عميل/مقاول)
  amount         Float?
  totalValue     Float     @default(0)
  notes          String?
  accountName    String?
  cashAccountId  String? // خزينة/بنك مرتبط (Account)
  vehicleNo      String?
  driverName     String?
  journalEntryId String?   @unique // القيد المحاسبي المرتبط (للسندات المالية)
  userId         String? // المنشئ (User)
  userName       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sourceBranch  Branch?       @relation("OpVoucherSource", fields: [sourceBranchId], references: [id])
  destBranch    Branch?       @relation("OpVoucherDest", fields: [destBranchId], references: [id])
  employee      User?         @relation("OpVoucherEmployee", fields: [employeeId], references: [id])
  creator       User?         @relation("OpVoucherCreator", fields: [userId], references: [id])
  courier       Party?        @relation("OpVoucherCourier", fields: [courierId], references: [id])
  party         Party?        @relation("OpVoucherParty", fields: [partyId], references: [id])
  cashAccount   Account?      @relation("OpVoucherCashAccount", fields: [cashAccountId], references: [id])
  journalEntry  JournalEntry? @relation(fields: [journalEntryId], references: [id])
  invoiceId     String?              // سند قبض مرتبط بفاتورة عميل (دفعة تحصيل)
  invoice       Invoice?      @relation("OpVoucherInvoice", fields: [invoiceId], references: [id])
  items         OpVoucherItem[]
  actions       OpVoucherAction[]

  @@index([invoiceId])

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model OpVoucherItem {
  id         String   @id @default(cuid())
  voucherId  String
  shipmentId String
  notes      String?
  addedAt    DateTime @default(now())
  addedBy    String?
  voucher  OpVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  shipment Shipment  @relation(fields: [shipmentId], references: [id])

  @@unique([voucherId, shipmentId])
  @@index([shipmentId])
}

model OpVoucherAction {
  id        String   @id @default(cuid())
  voucherId String
  action    String
  userId    String?
  userName  String
  at        DateTime @default(now())
  notes     String?
  voucher OpVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

// ============================================================
// البنود الإضافية على حساب المقاول (S2) — تعتيق/مبيت/مرتجعات
// قاعدة العمل الحاسمة: المبيت والمرتجعات لا تدخل مستحقات المقاول
// إلا بعد اعتماد الشركة (approvalStatus = approved) — وعند الاعتماد
// يُرحّل قيد مزدوج: مدين تكلفة النقل 5101 / دائن مقاولو النقل 2102.
// التعتيق يُعتمد تلقائيًا عند الإنشاء (بند قياسي متفق عليه).
// ============================================================
model ExtraCost {
  id              String    @id @default(cuid())
  ref             String    @unique   // EC-0001 (تسلسلي آمن)
  type            String    // taateeq | mabeet | return
  amount          Float
  notes           String?
  approvalStatus  String    @default("pending") // pending | approved | rejected
  contractorId    String
  shipmentId      String?
  date            DateTime  @default(now())
  journalEntryId  String?   @unique  // القيد المحاسبي المرتبط (يُنشأ عند الاعتماد)
  // F2: مصدر البند — 'shipment_sync' بند متزامن تلقائيًا من حقول الشحنة
  // (تعتيق/مبيت/تحويلة/دروب في جدول الصباح) و'null' بند يدوي من وحدة البنود الإضافية.
  // المزامنة تلمس فقط بنود shipment_sync — البنود اليدوية لا تُمس أبدًا (منع التكرار المحاسبي).
  source          String?
  userId          String?
  userName        String?
  approvalUserId  String?
  approvalUserName String?
  approvalAt      DateTime?
  approvalNotes   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  contractor      Party        @relation("ExtraCostContractor", fields: [contractorId], references: [id])
  shipment        Shipment?    @relation(fields: [shipmentId], references: [id])
  journalEntry    JournalEntry? @relation("ExtraCostJournal", fields: [journalEntryId], references: [id])

  @@index([contractorId, approvalStatus])
  @@index([shipmentId])
  @@index([type])
  @@index([date])
}

// ============================================================
// المصروفات العمومية والتشغيلية (OE) — مصروفات يومية للمكتب
// (لابتوب/أدوات مكتب/بوفية/مشتريات...إلخ) مستقلة عن حساب المقاول.
// قيد مزدوج عند الإنشاء: مدين حساب المصروف / دائن الصندوق أو البنك.
// التعديل يُعكس القيد ويُعاد إثباته بالبيانات الجديدة (نفس محرك البنود الإضافية).
// ============================================================
model OperatingExpense {
  id             String    @id @default(cuid())
  ref            String    @unique   // OE-0001 (تسلسلي آمن)
  date           DateTime  @default(now())
  accountId      String              // حساب المصروف (مدين) — 5101..5105
  payAccountId   String?             // الصندوق/البنك المدفوع منه (دائن) — 1101/1102
  amount         Float
  category       String    @default("operating") // operating | general | other
  vendor         String?             // المورد/المتجر (نص حر)
  notes          String?
  branchId       String?
  journalEntryId String?   @unique   // القيد المحاسبي المرتبط
  userId         String?
  userName       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  account      Account       @relation("OpExExpenseAccount", fields: [accountId], references: [id])
  payAccount   Account?      @relation("OpExPayAccount", fields: [payAccountId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  journalEntry JournalEntry? @relation("OpExJournal", fields: [journalEntryId], references: [id])

  @@index([date])
  @@index([accountId])
  @@index([category])
  @@index([branchId])
}

// عدادات تسلسلية آمنة (أرقام أذونات/قيود) — تمنع تكرار الأرقام بعد الحذف
model SeqCounter {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}

// منع تكرار العمليات (Idempotency) — مفتاح صادر من العميل لكل عملية منطقية
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  action    String
  result    String?
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String?
  name      String
  email     String?
  phone     String?
  branchId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  branch Branch? @relation(fields: [branchId], references: [id])
  roles  UserRole[]
  employeeVouchers OpVoucher[] @relation("OpVoucherEmployee")
  createdVouchers  OpVoucher[] @relation("OpVoucherCreator")
  sessions UserSession[]
}

/** جلسات الدخول المخزنة في قاعدة البيانات — تعمل عبر كل نسخ الوحدة في بيئة التطوير
 *  (كل مسار يحمل نسخته الخاصة من الذاكرة) وتصمد أمام إعادة التشغيل/التحديث الساخن */
model UserSession {
  token   String   @id
  userId  String
  at      DateTime @updatedAt
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  permissions String?
  createdAt   DateTime @default(now())
  users UserRole[]
}

/// كتالوج الصلاحيات المتزامن مع الكود (syncPermissionsCatalog) — مرآة قابلة للتدقيق
model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  group     String
  module    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  userId     String?
  userName   String?
  action     String
  entity     String
  entityId   String?
  beforeData String?
  afterData  String?
  notes      String?

  @@index([entity])
  @@index([date])
}

model ImportLog {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  fileName     String
  sheetName    String?
  totalRows    Int      @default(0)
  importedRows Int      @default(0)
  skippedRows  Int      @default(0)
  errorRows    Int      @default(0)
  errors       String?
  userId       String?
  userName     String?
  status       String   @default("completed")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  label     String?
  category  String?
  updatedAt DateTime @updatedAt
}

model LookupItem {
  id        String   @id @default(cuid())
  category  String
  key       String
  label     String
  labelEn   String?
  tone      String?
  icon      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([category, key])
  @@index([category])
}
