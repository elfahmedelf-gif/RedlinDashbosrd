model ExtraCost {
  id              String    @id @default(cuid())
  ref             String    @unique   // EC-0001 (طھط³ظ„ط³ظ„ظٹ ط¢ظ…ظ†)
  type            String    // taateeq | mabeet | return
  amount          Float
  notes           String?
  approvalStatus  String    @default("pending") // pending | approved | rejected
  contractorId    String
  shipmentId      String?
  date            DateTime  @default(now())
  journalEntryId  String?   @unique  // ط§ظ„ظ‚ظٹط¯ ط§ظ„ظ…ط­ط§ط³ط¨ظٹ ط§ظ„ظ…ط±طھط¨ط· (ظٹظڈظ†ط´ط£ ط¹ظ†ط¯ ط§ظ„ط§ط¹طھظ…ط§ط¯)
  // F2: ظ…طµط¯ط± ط§ظ„ط¨ظ†ط¯ â€” 'shipment_sync' ط¨ظ†ط¯ ظ…طھط²ط§ظ…ظ† طھظ„ظ‚ط§ط¦ظٹظ‹ط§ ظ…ظ† ط­ظ‚ظˆظ„ ط§ظ„ط´ط­ظ†ط©
  // (طھط¹طھظٹظ‚/ظ…ط¨ظٹطھ/طھط­ظˆظٹظ„ط©/ط¯ط±ظˆط¨ ظپظٹ ط¬ط¯ظˆظ„ ط§ظ„طµط¨ط§ط­) ظˆ'null' ط¨ظ†ط¯ ظٹط¯ظˆظٹ ظ…ظ† ظˆط­ط¯ط© ط§ظ„ط¨ظ†ظˆط¯ ط§ظ„ط¥ط¶ط§ظپظٹط©.
  // ط§ظ„ظ…ط²ط§ظ…ظ†ط© طھظ„ظ…ط³ ظپظ‚ط· ط¨ظ†ظˆط¯ shipment_sync â€” ط§ظ„ط¨ظ†ظˆط¯ ط§ظ„ظٹط¯ظˆظٹط© ظ„ط§ طھظڈظ…ط³ ط£ط¨ط¯ظ‹ط§ (ظ…ظ†ط¹ ط§ظ„طھظƒط±ط§ط± ط§ظ„ظ…ط­ط§ط³ط¨ظٹ).
  source          String?
  userId          String?
  userName        String?
  approvalUserId  String?
  approvalUserName String?
  approvalAt      DateTime?
  approvalNotes   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  contractor      Party        @relation("ExtraCostContractor", fields: [contractorId], references: [id])
  shipment        Shipment?    @relation(fields: [shipmentId], references: [id])
  journalEntry    JournalEntry? @relation("ExtraCostJournal", fields: [journalEntryId], references: [id])

  @@index([contractorId, approvalStatus])
  @@index([shipmentId])
  @@index([type])
  @@index([date])
}

// ط¹ط¯ط§ط¯ط§طھ طھط³ظ„ط³ظ„ظٹط© ط¢ظ…ظ†ط© (ط£ط±ظ‚ط§ظ… ط£ط°ظˆظ†ط§طھ/ظ‚ظٹظˆط¯) â€” طھظ…ظ†ط¹ طھظƒط±ط§ط± ط§ظ„ط£ط±ظ‚ط§ظ… ط¨ط¹ط¯ ط§ظ„ط­ط°ظپ
model SeqCounter {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}

// ظ…ظ†ط¹ طھظƒط±ط§ط± ط§ظ„ط¹ظ…ظ„ظٹط§طھ (Idempotency) â€” ظ…ظپطھط§ط­ طµط§ط¯ط± ظ…ظ† ط§ظ„ط¹ظ…ظٹظ„ ظ„ظƒظ„ ط¹ظ…ظ„ظٹط© ظ…ظ†ط·ظ‚ظٹط©
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  action    String
  result    String?
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String?
  name      String
  email     String?
  phone     String?
  branchId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  branch Branch? @relation(fields: [branchId], references: [id])
  roles  UserRole[]
  employeeVouchers OpVoucher[] @relation("OpVoucherEmployee")
  createdVouchers  OpVoucher[] @relation("OpVoucherCreator")
  sessions UserSession[]
}

/** ط¬ظ„ط³ط§طھ ط§ظ„ط¯ط®ظˆظ„ ط§ظ„ظ…ط®ط²ظ†ط© ظپظٹ ظ‚ط§ط¹ط¯ط© ط§ظ„ط¨ظٹط§ظ†ط§طھ â€” طھط¹ظ…ظ„ ط¹ط¨ط± ظƒظ„ ظ†ط³ط® ط§ظ„ظˆط­ط¯ط© ظپظٹ ط¨ظٹط¦ط© ط§ظ„طھط·ظˆظٹط±
 *  (ظƒظ„ ظ…ط³ط§ط± ظٹط­ظ…ظ„ ظ†ط³ط®طھظ‡ ط§ظ„ط®ط§طµط© ظ…ظ† ط§ظ„ط°ط§ظƒط±ط©) ظˆطھطµظ…ط¯ ط£ظ…ط§ظ… ط¥ط¹ط§ط¯ط© ط§ظ„طھط´ط؛ظٹظ„/ط§ظ„طھط­ط¯ظٹط« ط§ظ„ط³ط§ط®ظ† */
model UserSession {
  token   String   @id
  userId  String
  at      DateTime @updatedAt
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  permissions String?
  createdAt   DateTime @default(now())
  users UserRole[]
}

/// ظƒطھط§ظ„ظˆط¬ ط§ظ„طµظ„ط§ط­ظٹط§طھ ط§ظ„ظ…طھط²ط§ظ…ظ† ظ…ط¹ ط§ظ„ظƒظˆط¯ (syncPermissionsCatalog) â€” ظ…ط±ط¢ط© ظ‚ط§ط¨ظ„ط© ظ„ظ„طھط¯ظ‚ظٹظ‚
model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  group     String
  module    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  date       DateTime @default(now())
  userId     String?
  userName   String?
  action     String
  entity     String
  entityId   String?
  beforeData String?
  afterData  String?
  notes      String?

  @@index([entity])
  @@index([date])
}

model ImportLog {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  fileName     String
  sheetName    String?
  totalRows    Int      @default(0)
  importedRows Int      @default(0)
  skippedRows  Int      @default(0)
  errorRows    Int      @default(0)
  errors       String?
  userId       String?
  userName     String?
  status       String   @default("completed")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  label     String?
  category  String?
  updatedAt DateTime @updatedAt
}

model LookupItem {
  id        String   @id @default(cuid())
  category  String
  key       String
  label     String
  labelEn   String?
  tone      String?
  icon      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([category, key])
  @@index([category])
}

